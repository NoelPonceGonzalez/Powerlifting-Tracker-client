# Copia este archivo a .env y ajusta solo si hace falta.

# --- API ---
# Vacío = comportamiento por defecto.
# En `npm run dev` la UI corre en http://localhost:5180 y el proxy de Vite
# reenvía /api y /health a http://127.0.0.1:3000 (Powerlifting-APP/server).
# En producción usa el mismo origen, con los rewrites de vercel.json hacia la API.
# Solo defínelo si la API vive en otro dominio HTTPS.
# VITE_API_BASE_URL=https://tu-api

# --- Notificaciones push del servidor (opcional) ---
# Si está vacío, el cliente pide la clave a GET /api/notifications/vapid-public-key.
# Debe coincidir con VAPID_PUBLIC_KEY de server/.env.
# VITE_VAPID_PUBLIC_KEY=

# --- Desarrollo ---
# Registra el service worker también con `npm run dev` (rompe el HMR; normalmente usa `npm run build && npm run preview`).
# VITE_ENABLE_SW_IN_DEV=true
